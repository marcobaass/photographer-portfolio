---
import AboutMeAstro from '../components/AboutMe.astro';
import Clients from '../components/Clients.astro';
import BaseLayout from '../Layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
---


<BaseLayout
  title="Über mich | Marco Baaß Fotografie"
  description="Event- & Businessfotograf aus Berlin mit über 15 Jahren Erfahrung in Eventfotografie und Porträtfotografie."
  canonical="https://www.baass-fotografie.de/ueber-mich/"
>
  <section class="about-me-container">
    <AboutMeAstro />
  </section>
  <Clients />
  <Contact />
</BaseLayout>


<style>
  .about-me-container {
    margin-top: 0rem;
  }
</style>



 