---
import ImageSlider from "../components/ImageSlider.astro";
import IntroPhrases from "../components/IntroPhrases.astro";
import CategoryFadeIn from "../components/categoryFadeIn.astro";
import Kompetenz from "../components/kompetenz.astro";
import Contact from "../components/Contact.astro";
import BaseLayout from "../Layouts/BaseLayout.astro";


---
  <BaseLayout
    title="Eventfotografie & Businessportraits in Berlin | Marco Baaß"
    description="Eventfotografie, Businessportraits und Reportagen in Berlin für Unternehmen, Messen und Magazine. Authentische Bilder für starke Kommunikation."
    canonical="https://www.baass-fotografie.de/"
  >
    <ImageSlider />
    <IntroPhrases/>
    <CategoryFadeIn />
    <Kompetenz />
    <Contact />
  </BaseLayout>


<script type="application/ld+json">
  {
     "@context": "https://schema.org",
     "@type": "LocalBusiness",
     "name": "Marco Baaß - Eventfotografie & Businessportraits",
     "url": "https://www.baass-fotografie.de/",
    //  "image": "https://deinewebsite.de/logo.jpg",
     "description": "Eventfotografie und Businessportraits in Berlin mit langjähriger Erfahrung. Hochwertige Bilder für Unternehmen, Magazine & Events.",
     "address": {
         "@type": "PostalAddress",
         "streetAddress": "Pasteurstr. 53",
         "addressLocality": "Berlin",
         "postalCode": "10407",
         "addressCountry": "DE"
     },
     "telephone": "+49 151 19345758",
     "sameAs": [
      "https://www.linkedin.com/in/marcobaass"
    ]
  }
  </script>
