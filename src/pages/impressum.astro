---
import BaseLayout from '../Layouts/BaseLayout.astro';
---

<BaseLayout
  title="Impressum | Marco Baaß Fotografie"
  description="Impressum von Marco Baaß Fotografie."
  canonical="https://www.baass-fotografie.de/impressum/"
>
  <div class="legal">
    <div class="legal-content">
      <h1>Impressum - Marco Baaß Fotografie</h1>

      <h2>Angaben gemäß § 5 TMG:</h2>
      <p>Marco Baaß</p>
      <p>Pasteurstraße 53</p>
      <p>10407 Berlin</p>

      <p>Telefon: +49 151 193 45 758</p>
      <p>E-Mail: picture(at)marcobaass.com</p>

      <h2>Umsatzsteuer-Identifikationsnummer gemäß §27 a Umsatzsteuergesetz:</h2>
      <p>DE251654552</p>
    </div>
  </div>
</BaseLayout>

<style>
  .legal {
    padding: 0rem 0 4rem;
    background: var(--clr-bg-dark-full);
    gap: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
  }

  .legal h1 {
    color: white;
    margin-bottom: 3rem;
  }

  .legal h2 {
    color: white;
    margin-bottom: 1rem;
    text-align: center;
  }

  .legal p {
    font-size: 1.2rem;
    font-weight: 400;
    color: white;
    margin-bottom: 1rem;
    text-align: center;
  }

  .legal-content {
    color: white;
    padding: 1rem;
    border-radius: 8px;
    max-width: 75ch;
    margin: 0 auto;
  }
</style>


    