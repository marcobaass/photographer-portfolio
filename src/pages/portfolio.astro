---
import BaseLayout from '../Layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import Contact from '../components/Contact.astro';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/galleryImages/*.{jpeg,jpg,png,gif}',
  { eager: true }
);

const MAX_LONG_SIDE_THUMB = 450;
const MAX_LONG_SIDE_FULL = 1000;

const thumbnails = await Promise.all(
  Object.entries(images).map(async ([path, image]) => {
    const filename =
      path.split('/').pop()?.split('.')[0]?.replace(/[-_]/g, ' ') || 'Galeriebild';
    const altText = filename.charAt(0).toUpperCase() + filename.slice(1);

    const srcMeta = image.default;
    const isLandscape = srcMeta.width >= srcMeta.height;

    const thumbOpts = {
      src: srcMeta,
      format: 'webp',
      ...(isLandscape ? { width: MAX_LONG_SIDE_THUMB } : { height: MAX_LONG_SIDE_THUMB }),
    };

    const fullOpts = {
      src: srcMeta,
      format: 'webp',
      ...(isLandscape ? { width: MAX_LONG_SIDE_FULL } : { height: MAX_LONG_SIDE_FULL }),
    };

    const thumbResult = await getImage(thumbOpts);
    const fullResult = await getImage(fullOpts);

    return {
      thumb: thumbResult.src,
      fullsize: fullResult.src,
      alt: altText,
      ratio: srcMeta.width / srcMeta.height,
    };
  })
);
---

<BaseLayout
  title="Portfolio & Referenzen | Event- und Businessfotos Berlin"
  description="Bildbeispiele aus Eventfotografie, Businessportraits und Reportagen - ausgewählte Arbeiten von Marco Baaß."
  canonical="https://www.baass-fotografie.de/portfolio/"
>
  <article class="portfolio-text">
    <h1>Ausgewählte Arbeiten für Unternehmen und Events</h1>
    <p>Jedes Unternehmen erzählt seine eigene Geschichte. In meinem Portfolio finden Sie eine Auswahl professioneller Arbeiten aus den Bereichen Businessfotografie, Eventfotografie, Unternehmenskommunikation und dokumentarische Fotografie. Von authentischen Businessportraits für Geschäftsführer und Teams über die fotografische Begleitung von Konferenzen, Firmenevents und Messen bis hin zu Werbekampagnen für kleine Unternehmen - jede Bildserie entsteht mit dem Ziel, Menschen, Marken und Momente glaubwürdig und wirkungsvoll zu präsentieren.</p>
    <p>Als Fotograf aus Berlin lege ich Wert auf natürliche Bildsprache, echte Emotionen und eine moderne, hochwertige Bildästhetik. Ob CEO-Portraits, Mitarbeiterfotos, Eventreportagen oder authentische Unternehmensfotografie - meine Aufnahmen helfen Unternehmen dabei, Vertrauen aufzubauen und ihre Marke auf Websites, in sozialen Medien, Presseartikeln und Marketingkampagnen professionell zu präsentieren. Lassen Sie sich von meinen Referenzen inspirieren und entdecken Sie, wie individuelle Fotografie Ihre Unternehmenskommunikation stärken kann.
    <p>
      Hier erfahren Sie mehr über mich <a href="/ueber-mich/">über mich</a> und meine Arbeitsweise.
    </p>
  </article>
  <section class="portfolio">
    <div class="portfolio-container" id="portfolio-container">
      {thumbnails.map((image, index) => (
        <button
          type="button"
          class="portfolio-item"
          data-index={index}
          data-fullsize={image.fullsize}
          data-ratio={image.ratio}
        >
          <img
            src={image.thumb}
            alt={image.alt}
            loading={index < 4 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      ))}
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <img class="lightbox-image">
  </div>

  <Contact />
</BaseLayout>


<style>

  .portfolio-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
  }

  h1 {
    margin-top: 10rem;

  }

  p {
    color: white;
    max-width: 120ch;
    text-align: center;
    margin-bottom: 1rem;
  }

  a {
    color: var(--clr-accent);
    text-decoration: underline;
  }

  .portfolio {
    position: relative;
    overflow: visible;
    padding: 7rem 0;
  }

  .portfolio-container {
    --cols: 1;
    --col-gap: 0px;
    --row-gap: 0px;
    --pad-x: 10px;
    --pad-y: 10px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--col-gap);
    padding: var(--pad-y) var(--pad-x) calc(var(--pad-y) + 120px) var(--pad-x);
    align-items: start;
    width: 100%;
  }

  .portfolio-col {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    will-change: transform;
  }

  .portfolio-col:has(.portfolio-item:hover) {
    z-index: 1000;
  }

  .portfolio-item {
    display: block;
    position: relative;
    width: var(--w, 260px);
    height: var(--h, 180px);
    margin-inline: auto;    
    opacity: 0.75;
    transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
  }

  .portfolio-item:hover {
      transform: scale(1.1);
      opacity: 1;
      z-index: 1000;
      cursor: pointer;
  }

  .portfolio-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  .lightbox {
    display: grid;
    place-items: center;
    background-color: rgba(0, 0, 0, 0.85);
    cursor: pointer;
    position: fixed;
    inset: 0;
    z-index: 10000;
    opacity: 0;
  }
  
  .lightbox[hidden] {
    display: none;
    pointer-events: none;
  }

  .lightbox-image {
    max-width: 95vw;
    max-height: 95dvh;
    object-fit: contain;
  }

  .lightbox-content {
    position: relative;
    max-width: 80%;
    max-height: 80%;
  }

</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const container = document.getElementById('portfolio-container');
  const items = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.portfolio-item')
  );
  let columnTweens: gsap.core.Tween[] = [];

  function placeItems() {
    if (!container || items.length === 0) return;

    // Breakpoints based on window width
    const vw = window.innerWidth;
    // Number of columns based on window width
    let cols = 1;
    if (vw >= 1280) {
      cols = 3;
    } else if (vw >= 848) {
      cols = 2;
    } else {
      cols = 1;
    }

    // Gap between items based on window width
    let colGap = 24;
    let rowGap = 48;
    let padX = 20;
    let padY = 20;
    if (vw >= 1280) {
      colGap = 96;
      rowGap = 80;
      padX = 48;
      padY = 48;
    } else if (vw >= 848) {
      colGap = 64;
      rowGap = 56;
      padX = 32;
      padY = 32;
    } 

    container.style.setProperty('--cols', String(cols));
    container.style.setProperty('--col-gap', `${colGap}px`);
    container.style.setProperty('--row-gap', `${rowGap}px`);
    container.style.setProperty('--pad-x', `${padX}px`);
    container.style.setProperty('--pad-y', `${padY}px`);

    container.replaceChildren();

    const colEls = Array.from({ length: cols }, (_, col) => {
      const colEl = document.createElement('div');
      colEl.className = 'portfolio-col';
      colEl.dataset.col = String(col);
      container.appendChild(colEl);
      return colEl;
    });

    const containerW = container.clientWidth;
    const cellW = Math.max(0, (containerW - padX * 2 - colGap * (cols - 1)) / cols);
    const targetLong = Math.min(450, cellW * 0.9);

    const itemCountByCol = Array(cols).fill(0);

    items.forEach((item, index) => {
      const ratio = Number(item.dataset.ratio || 1);
      const isLandscape = ratio >= 1;

      const w = isLandscape ? targetLong : targetLong * ratio;
      const h = isLandscape ? targetLong / ratio : targetLong;

      item.style.setProperty('--w', `${w}px`);
      item.style.setProperty('--h', `${h}px`);

      const col = index % cols;
      item.dataset.col = String(col);
      item.style.marginTop = itemCountByCol[col] === 0 ? '0px' : `${rowGap}px`;
      colEls[col].appendChild(item);
      itemCountByCol[col] += 1;
    });

    columnTweens.forEach((tween) => tween.kill());
    columnTweens = [];

    colEls.forEach((colEl) => {
      const col = Number(colEl.dataset.col || 0);
      const fromY = col % 2 === 0 ? 160 : -160;

      gsap.set(colEl, { y: 0 });

      const tween = gsap.to(colEl, {
        y: fromY,
        ease: 'none',
        scrollTrigger: {
          trigger: container,
          start: 'top 50%',
          end: 'bottom 100%',
          scrub: 1.5,
          invalidateOnRefresh: true,
        },
      });

      columnTweens.push(tween);
    });

    ScrollTrigger.refresh();
  }

  placeItems();
  let resizeRaf: number | undefined;
  window.addEventListener('resize', () => {
    if (resizeRaf) cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(placeItems);
  });

  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.querySelector<HTMLImageElement>('.lightbox-image');

  if (lightbox && lightboxImage) {
    const openLightbox = (item: HTMLButtonElement) => {
      const fullsize = item.dataset.fullsize;
      const img = item.querySelector('img');
      if (!fullsize || !img) return;

      lightboxImage.src = fullsize;
      lightboxImage.alt = img.alt;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';

      gsap.to('.lightbox', { opacity: 1, duration: 1, ease: 'power2.out' });
    };

    const closeLightbox = () => {
      gsap.to('.lightbox', {
        opacity: 0,
        duration: 0.25,
        ease: 'power2.out',
        onComplete: () => {
          lightbox.hidden = true;
          lightboxImage.removeAttribute('src');
          document.body.style.overflow = '';
        },
      });
    };

    items.forEach((item) => {
      item.addEventListener('click', () => openLightbox(item));
    });

    lightbox.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });
  }

</script>
