---
// src/layouts/BaseLayout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../components/style.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Eventfotografie & Businessportraits in Berlin | Marco Baaß',
  description = 'Eventfotografie, Businessportraits & Reportagen in Berlin - Fotograf für Firmenfeiern, Messen, Magazine. Erfahrung für authentische Momente.',
  canonical = 'https://www.baass-fotografie.de/',
} = Astro.props;
---
<html lang="de">
	<head>
	<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="keywords" content="Eventfotografie Berlin, Businessportraits, Reportagefotografie, Firmenfeier Fotograf, Messefotografie, Unternehmensfotografie">
    <meta name="author" content="Marco Baaß">
    <title>{title}</title>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <!-- <meta property="og:image" content="https://deinewebsite.de/images/vorschaubild.jpg"> -->
    <!-- <meta property="og:url" content="https://deinewebsite.de"> -->
    <meta property="og:type" content="website">
    <link rel="icon" href="/favicon.png">
    <link rel="canonical" href={canonical} />
	</head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>