<style>
  .footer {
    background-color: var(--clr-bg-dark-full);
    padding-bottom: var(--space-3xs);
  }

  .footerContent {
    display: flex;
    justify-content: space-between;
    margin: var(--space-l);
  }

  .icons {
    display: flex;
    gap: var(--space-2xs);
  }

  #phone {
    display: flex;
    align-items: center;
    gap: var(--space-3xs)
  }

  .svgBerlinPhotographers {
    width: calc(var(--step-2) * 2);
    align-self: center;
  }

  .dsvgo {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    gap: var(--space-s);
  }

  [data-icon] {
    font-size: var(--step-2);
  }


  [data-icon="mdi:phone"] {
    font-size: var(--step-0);
    text-align: center;
  }
